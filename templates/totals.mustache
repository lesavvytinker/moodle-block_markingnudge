{{!
    @template block_markingnudge/totals

    What's waiting across the assessor's courses, and a button to the marking page.

    Example context (json):
    {
        "hasitems": true,
        "items": [{"count": 5, "label": "to mark", "key": "tomark"}, {"count": 1, "label": "need feedback", "key": "feedback"}],
        "hasoverdue": true,
        "overdue": [{"count": 1, "level": "red", "label": "waiting 14+ days"}, {"count": 1, "level": "amber", "label": "waiting 7+ days"}],
        "url": "https://example.com/report/evidencereporter/marking.php"
    }
}}
<div class="block-markingnudge">
    {{#hasitems}}
    <ul class="list-unstyled mb-2">
        {{#items}}
        <li class="bmn-item bmn-{{key}}"><span class="bmn-count">{{count}}</span> {{label}}</li>
        {{/items}}
    </ul>
    {{/hasitems}}
    {{#hasoverdue}}
    <p class="mb-2">
        {{#overdue}}<span class="badge bmn-{{level}} me-1">{{count}} {{label}}</span>{{/overdue}}
    </p>
    {{/hasoverdue}}
    {{^hasitems}}
    <p class="text-muted mb-2">{{#str}} caughtup, block_markingnudge {{/str}}</p>
    {{/hasitems}}
    <a href="{{url}}" class="btn btn-primary btn-sm">{{#str}} gotomarking, block_markingnudge {{/str}}</a>
</div>
